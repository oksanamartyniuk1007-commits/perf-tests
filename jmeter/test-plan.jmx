              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="UpdateCart_Chair" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper

if (prev.isSuccessful()) {
    def raw = vars.get(&quot;cartContent&quot;)
    def cart = raw ? new LinkedHashMap(new JsonSlurper().parseText(raw)) : [:]
    def key = vars.get(&quot;chairProductId&quot;) + &quot;__&quot;
    cart[key] = (cart[key] ?: 0) + 1
    vars.put(&quot;cartContent&quot;, JsonOutput.toJson(cart))
}</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
