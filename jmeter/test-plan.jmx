              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="PickRandomChair" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def matchNrStr = vars.get(&quot;chairSlug_matchNr&quot;)
int matchNr = matchNrStr ? matchNrStr.toInteger() : 0

// збираємо тільки валідні слаги (без &quot;/&quot;, &quot;feed&quot;, порожніх значень)
def validSlugs = []
for (int i = 1; i &lt;= matchNr; i++) {
    def slug = vars.get(&quot;chairSlug_&quot; + i)
    if (slug &amp;&amp; !slug.contains(&quot;/&quot;) &amp;&amp; !slug.toLowerCase().contains(&quot;feed&quot;)) {
        validSlugs &lt;&lt; slug
    }
}

if (!validSlugs.isEmpty()) {
    def chosenSlug = validSlugs[new Random().nextInt(validSlugs.size())]
    vars.put(&quot;chairSlug&quot;, chosenSlug)
    log.info(&quot;Thread &quot; + ctx.getThreadNum() + &quot;: обрано &apos;&quot; + chosenSlug + &quot;&apos; з &quot; + validSlugs.size() + &quot; валідних варіантів&quot;)
} else {
    vars.put(&quot;chairSlug&quot;, &quot;modern-chair1&quot;)
    log.warn(&quot;Thread &quot; + ctx.getThreadNum() + &quot;: валідних слагів не знайдено, використано дефолт&quot;)
}</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
