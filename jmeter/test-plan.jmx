            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="UpdateCart_Table" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonOutput

// Table is always the first item of a new user&apos;s cart
if (prev.isSuccessful()) {
    def cart = [:]
    cart[vars.get(&quot;tableProductId&quot;) + &quot;__&quot;] = 1
    vars.put(&quot;cartContent&quot;, JsonOutput.toJson(cart))
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
