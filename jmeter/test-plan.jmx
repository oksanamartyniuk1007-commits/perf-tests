              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert Order Placed" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def urls = [prev.getURL()?.toString()]
prev.getSubResults().each { urls &lt;&lt; it.getURL()?.toString() }

if (!urls.any { it != null &amp;&amp; it.contains(&quot;thank-you&quot;) }) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Order not placed: no redirect to thank-you page. URLs: &quot; + urls)
}</stringProp>
