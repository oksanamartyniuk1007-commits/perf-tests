            <hashTree>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="ParseCheckoutForm" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import org.jsoup.Jsoup
import java.net.URLEncoder

def doc = Jsoup.parse(prev.getResponseDataAsString())
def form = doc.select(&quot;form:has(input[name=cart_name])&quot;).first()

if (form == null) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;Checkout form not found (cart may be empty)&quot;)
    vars.put(&quot;checkoutHiddenParams&quot;, &quot;&quot;)
    return
}

// All hidden fields of the real form: trans_id, cart_content, product_price_*, total_net, nonce etc.
def hidden = new LinkedHashMap&lt;String, String&gt;()
form.select(&quot;input[type=hidden][name]&quot;).each { el -&gt;
    def n = el.attr(&quot;name&quot;)
    if (!hidden.containsKey(n)) {
        hidden[n] = el.attr(&quot;value&quot;)
    }
}

if (!hidden[&quot;cart_content&quot;]) {
    hidden[&quot;cart_content&quot;] = vars.get(&quot;cartContent&quot;) ?: &quot;&quot;
    log.warn(&quot;Thread &quot; + ctx.getThreadNum() + &quot;: cart_content not found on checkout, using JMeter cart &quot; + hidden[&quot;cart_content&quot;])
}
if (!hidden[&quot;trans_id&quot;]) {
    hidden[&quot;trans_id&quot;] = System.currentTimeMillis().toString() + new Random().nextInt(10)
    log.warn(&quot;Thread &quot; + ctx.getThreadNum() + &quot;: trans_id not found on checkout, generated &quot; + hidden[&quot;trans_id&quot;])
}
hidden.putIfAbsent(&quot;ic_formbuilder_redirect&quot;, &quot;http://localhost/thank-you&quot;)
hidden.putIfAbsent(&quot;shipping&quot;, &quot;order&quot;)
hidden.putIfAbsent(&quot;cart_type&quot;, &quot;order&quot;)

vars.put(&quot;transId&quot;, hidden[&quot;trans_id&quot;])
vars.put(&quot;checkoutHiddenParams&quot;, hidden.collect { k, v -&gt;
    URLEncoder.encode(k, &quot;UTF-8&quot;) + &quot;=&quot; + URLEncoder.encode(v, &quot;UTF-8&quot;)
}.join(&quot;&amp;&quot;))
log.info(&quot;Thread &quot; + ctx.getThreadNum() + &quot;: checkout hidden fields &quot; + hidden.keySet())</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
